# --- Core ---
DATABASE_URL="postgresql://leadhunter:leadhunter@localhost:5433/leadhunter"
REDIS_URL="redis://localhost:6380"
APP_URL="http://localhost:3000"

# --- AI (Claude) ---
ANTHROPIC_API_KEY=""
# Main model: discovery + writing emails
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Cheaper model: scoring leads + classifying replies
ANTHROPIC_MODEL_FAST="claude-haiku-5-5"

# --- Finding emails (optional) ---
# Hunter.io finds published work emails for a domain (free tier available).
# Leave empty to rely on the website + Claude web search only.
HUNTER_API_KEY=""

# --- Email sending (SMTP) ---
# Gmail/Google Workspace: smtp.gmail.com, port 465, use an App Password
# Zoho: smtp.zoho.com, port 465 | Outlook/M365: smtp.office365.com, port 587
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# --- Reading replies (IMAP) ---
# Gmail: imap.gmail.com | Zoho: imap.zoho.com | Outlook/M365: outlook.office365.com
# User/password default to the SMTP ones if left empty
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""

# Signs unsubscribe links. Any long random string, e.g. `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=""

# --- Worker ---
TICK_EVERY_MINUTES="5"
INBOX_EVERY_MINUTES="2"
WORKER_CONCURRENCY="3"
# Only send on weekdays inside this window, in the prospects' timezone
SEND_WINDOW="08:00-17:30"
SEND_TIMEZONE="Africa/Lagos"
# SEND_WEEKENDS="true"

# --- Booking webhooks (meeting scheduled) ---
# Any long random string; paste the same value into the Cal.com webhook "Secret"
CALCOM_WEBHOOK_SECRET=""
# Signing key you choose when creating the Calendly webhook subscription
CALENDLY_WEBHOOK_SIGNING_KEY=""

# --- Phone calls ---
# Country code for local numbers like 0803... (234 = Nigeria, 44 = UK)
DEFAULT_COUNTRY_CODE="234"
# "manual" (default): you make the calls from the task list.
# "vapi": EXPERIMENTAL AI calls, only to leads who already said yes by email.
VOICE_PROVIDER="manual"
VAPI_API_KEY=""
VAPI_ASSISTANT_ID=""
VAPI_PHONE_NUMBER_ID=""
# Set to true only after checking AI calling is lawful for your leads (consent rules)
VAPI_CONSENT_ACKNOWLEDGED="false"
