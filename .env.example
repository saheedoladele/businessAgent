# --- Core ---
DATABASE_URL="postgresql://leadhunter:leadhunter@localhost:5433/leadhunter"
REDIS_URL="redis://localhost:6380"
APP_URL="http://localhost:3000"

# --- AI (Claude) ---
ANTHROPIC_API_KEY=""
# Main model: discovery + writing emails
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Cheaper model: scoring leads + classifying replies
ANTHROPIC_MODEL_FAST="claude-haiku-5-5"

# --- Email sending (SMTP) ---
# Gmail/Google Workspace: smtp.gmail.com, port 465, use an App Password
# Zoho: smtp.zoho.com, port 465 | Outlook/M365: smtp.office365.com, port 587
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Signs unsubscribe links. Any long random string, e.g. `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=""

# --- Worker ---
TICK_EVERY_MINUTES="5"
WORKER_CONCURRENCY="3"
# Only send on weekdays inside this window, in the prospects' timezone
SEND_WINDOW="08:00-17:30"
SEND_TIMEZONE="Africa/Lagos"
# SEND_WEEKENDS="true"
