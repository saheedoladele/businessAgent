{
  "name": "leadhunter",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that finds qualified customers for a business, reaches out, follows up and books meetings.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx --env-file=.env scripts/seed-business.ts",
    "discover": "tsx --env-file=.env scripts/discover.ts",
    "enrich": "tsx --env-file=.env scripts/enrich.ts",
    "draft": "tsx --env-file=.env scripts/draft.ts",
    "send": "tsx --env-file=.env scripts/send.ts",
    "smtp:test": "tsx --env-file=.env scripts/smtp-test.ts",
    "ai:check": "tsx --env-file=.env scripts/ai-check.ts",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "inbox": "tsx --env-file=.env scripts/inbox.ts",
    "booking:test": "tsx --env-file=.env scripts/simulate-booking.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.7.8",
    "imapflow": "^2.12.1",
    "ioredis": "^6.0.0",
    "mailparser": "^3.14.5",
    "next": "^15.5.0",
    "nodemailer": "^10.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
